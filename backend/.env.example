# Copia este archivo como .env y ajusta los valores. NUNCA subas .env a Git.

# Entorno: development | test | production. Si no se declara: production con Firebase real y
# development con emuladores. En production no se publican /docs ni /openapi.json.
VIGIA_ENVIRONMENT=development

# Orígenes permitidos para el portal web (separados por coma)
VIGIA_CORS_ORIGINS=http://localhost:5173

# Proyecto Firebase. "demo-vigia" solo existe en los emuladores locales (sin costo, sin datos reales).
VIGIA_FIREBASE_PROJECT_ID=demo-vigia

# Emuladores (host:puerto). Déjalos vacíos para usar Firebase real; prohibidos en producción.
VIGIA_AUTH_EMULATOR_HOST=127.0.0.1:9099
VIGIA_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Con Firebase real, las credenciales NO van aquí: se usan Application Default Credentials
# (variable GOOGLE_APPLICATION_CREDENTIALS apuntando a un archivo fuera del repositorio).

# Secreto del cron externo (POST /internal/tick, cabecera X-Cron-Secret). Vacío = tick desactivado.
# En producción debe tener 32 caracteres o más; genéralo con: python -c "import secrets; print(secrets.token_urlsafe(32))"
VIGIA_CRON_SECRET=
