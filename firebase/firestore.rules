rules_version = '2';

// VIGIA: los clientes (app y portal) NO leen ni escriben Firestore directamente.
// Todo acceso pasa por el backend FastAPI, que usa Firebase Admin SDK.
// Admin SDK ignora estas reglas, por eso pueden negar todo sin afectar al backend.
// Ver docs/decisiones.md (ADR 002).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
